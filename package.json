{
  "name": "@rero/ng-core",
  "version": "22.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve --configuration localhost",
    "build-css": "postcss  --config projects/rero/ng-core projects/rero/ng-core/tailwind.css -o projects/rero/ng-core/assets/scss/ng-core-tailwind.scss",
    "build-lib": "ng build --configuration production @rero/ng-core",
    "pack": "pnpm run build-css && ng build --configuration production @rero/ng-core && cd dist/rero/ng-core && pnpm pack --pack-destination ../../..",
    "test-lib": "ng test @rero/ng-core",
    "lint": "ng lint --cache",
    "extract_messages": "ngx-translate-extract -k -c -s -i ./projects/rero/ng-core/src ./projects/rero/ng-core/barcode-scanner/src ./projects/rero/ng-core/editor/src -o ./projects/rero/ng-core/translations/messages.json --fi '  '",
    "update_catalog": "ngx-translate-extract -k -c -s -i ./projects/rero/ng-core/src ./projects/rero/ng-core/barcode-scanner/src ./projects/rero/ng-core/editor/src -o ./projects/rero/ng-core/src/lib/translate/i18n/{de,en,fr,it,ar,cs,eo,es,nl,ta,uk}.json --fi '  '",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "semantic-release"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^22.0.1",
    "@ngx-formly/core": "^11.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-locale": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "barcode-detector": "^3.2.3",
    "easymde": "^2.21.0",
    "generate-password-lite": "^1.1.1",
    "katex": "^0.19.1",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "marked": "^18.1.2",
    "ngx-spinner": "^22.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@ngx-formly/schematics": "^11.0.0",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/json-schema": "^7.0.15",
    "@types/katex": "^0.16.8",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.6",
    "@vendure/ngx-translate-extract": "^10.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-rename": "^0.8.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
